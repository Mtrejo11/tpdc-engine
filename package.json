{
  "name": "tpdc-engine",
  "version": "0.4.0-alpha.9",
  "description": "Autonomous development workflow engine — request to PR with CI green. Shipped as Claude Code plugin + MCP server.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "tpdc-plugin/",
    "marketplace.json"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "mcp",
    "autonomous-dev",
    "code-generation"
  ],
  "author": "mtrejo11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mtrejo11/tpdc-engine"
  },
  "bin": {
    "tpdc-engine": "dist/cli/index.js",
    "tpdc": "dist/cli/index.js",
    "tpdc-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "mcp:dev": "tsx src/mcp/server.ts",
    "start": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
