{
  "name": "tpdc-engine",
  "version": "0.2.0-alpha.0",
  "description": "Autonomous development workflow engine — request to PR with CI green. v2 rewrite on Inngest + Claude Agent SDK.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "tpdc-plugin/",
    "marketplace.json"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "mcp",
    "inngest",
    "autonomous-dev",
    "code-generation",
    "workflow-engine"
  ],
  "author": "mtrejo11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mtrejo11/tpdc-engine"
  },
  "bin": {
    "tpdc-engine": "dist/cli/index.js",
    "tpdc": "dist/cli/index.js",
    "tpdc-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "inngest:dev": "npx inngest-cli@latest dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@hono/node-server": "^1.16.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "hono": "^4.10.0",
    "inngest": "^3.40.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
